<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-neo-yellow text-black font-sans antialiased min-h-screen flex flex-col selection:bg-black selection:text-white">

    <!-- Navigation Bar -->
    <nav class="fixed w-full z-50 top-0 transition-all duration-300 bg-neo-yellow border-b-4 border-black">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-24">
                <div class="flex-shrink-0 flex items-center">
                    <a href="/" class="text-3xl font-black tracking-tighter uppercase font-display border-4 border-black px-4 py-2 bg-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:shadow-none hover:translate-x-[4px] hover:translate-y-[4px] transition-all">
                        STOCK
                    </a>
                </div>
                <div class="hidden md:flex space-x-4 items-center" id="desktop-nav-links">
                    <a href="/" class="text-lg font-bold border-2 border-transparent hover:border-black hover:bg-white px-4 py-1 transition-all uppercase tracking-tight">Início</a>
                    <a href="/portfolio" class="text-lg font-bold border-2 border-transparent hover:border-black hover:bg-white px-4 py-1 transition-all uppercase tracking-tight">Portfólio</a>
                    <a href="/profile" class="text-lg font-bold border-2 border-transparent hover:border-black hover:bg-white px-4 py-1 transition-all uppercase tracking-tight">Perfil</a>
                </div>
                <!-- Mobile menu button -->
                <div class="md:hidden flex items-center">
                    <button id="mobile-menu-btn" class="border-4 border-black p-2 bg-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] active:shadow-none active:translate-x-[4px] active:translate-y-[4px] transition-all">
                        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-neo-yellow border-t-4 border-black px-4 py-6">
            <div class="flex flex-col space-y-4" id="mobile-nav-links">
                <a href="/" class="text-2xl font-black uppercase border-b-4 border-black pb-2">Início</a>
                <a href="/portfolio" class="text-2xl font-black uppercase border-b-4 border-black pb-2">Portfólio</a>
                <a href="/profile" class="text-2xl font-black uppercase border-b-4 border-black pb-2">Perfil</a>
            </div>
        </div>
    </nav>

    <!-- Main Content Wrapper -->
    <main class="flex-grow pt-20">
